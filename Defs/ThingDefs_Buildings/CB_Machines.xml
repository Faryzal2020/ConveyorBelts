<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef Abstract="True" Name="CB_MachineBase" ParentName="BuildingBase">
    <category>Building</category>
    <graphicData>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <size>(1,1)</size>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Standable</passability>
    <rotatable>true</rotatable>
    <selectable>true</selectable>
    <useHitPoints>true</useHitPoints>
    <leaveResourcesWhenKilled>true</leaveResourcesWhenKilled>
    <designationCategory>CB_Conveyors</designationCategory>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <WorkToBuild>400</WorkToBuild>
      <Flammability>0.5</Flammability>
      <Beauty>-2</Beauty>
    </statBases>
    <costList>
      <Steel>10</Steel>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
  </ThingDef>

  <ThingDef ParentName="CB_MachineBase">
    <defName>CB_BeltMotor</defName>
    <label>belt motor</label>
    <description>Drives the conveyor line it faces. Draws 20 W plus the line's per-tile power while driving, 5 W otherwise. If several motors face one line, the first powered one drives it.</description>
    <thingClass>ConveyorBelts.Building_BeltMotor</thingClass>
    <tickerType>Normal</tickerType>
    <graphicData>
      <texPath>ConveyorBelts/Motor</texPath>
    </graphicData>
    <uiIconPath>ConveyorBelts/Motor_north</uiIconPath>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>5</basePowerConsumption>
        <shortCircuitInRain>false</shortCircuitInRain>
      </li>
    </comps>
  </ThingDef>
  <ThingDef ParentName="CB_MachineBase">
    <defName>CB_InputPort</defName>
    <label>input port</label>
    <description>Holds one stack. Haulers bring it the items allowed in its Port tab (nothing by default). While powered it puts the stack onto adjacent belts that don't point into it, a belt's max stack at a time, taking turns between several belts. Draws 50 W.</description>
    <thingClass>ConveyorBelts.Building_InputPort</thingClass>
    <tickerType>Normal</tickerType>
    <graphicData>
      <texPath>ConveyorBelts/InputPort</texPath>
    </graphicData>
    <uiIconPath>ConveyorBelts/InputPort_north</uiIconPath>
    <surfaceType>Item</surfaceType>
    <inspectorTabs>
      <li>ConveyorBelts.ITab_Port</li>
    </inspectorTabs>
    <building>
      <maxItemsInCell>1</maxItemsInCell>
      <preventDeteriorationOnTop>true</preventDeteriorationOnTop>
      <storageGroupTag>CB_InputPort</storageGroupTag>
      <fixedStorageSettings>
        <filter>
          <disallowNotEverStorable>true</disallowNotEverStorable>
          <categories>
            <li>Root</li>
          </categories>
        </filter>
      </fixedStorageSettings>
      <defaultStorageSettings>
        <priority>Normal</priority>
      </defaultStorageSettings>
    </building>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>50</basePowerConsumption>
        <shortCircuitInRain>false</shortCircuitInRain>
      </li>
    </comps>
  </ThingDef>
  <ThingDef ParentName="CB_MachineBase">
    <defName>CB_PusherPort</defName>
    <label>pusher port</label>
    <description>Takes the stacks a belt delivers into it and pushes them into the machine it faces: storage such as hoppers and shelves, anything that takes fuel, fermenting barrels (wort) and construction frames (missing materials). Items the machine won't take are held or thrown to a side cell (onto a belt pointing away, else onto the ground), as set in its Port tab. Draws 50 W.</description>
    <thingClass>ConveyorBelts.Building_PusherPort</thingClass>
    <tickerType>Normal</tickerType>
    <graphicData>
      <texPath>ConveyorBelts/PusherPort</texPath>
    </graphicData>
    <uiIconPath>ConveyorBelts/PusherPort_north</uiIconPath>
    <inspectorTabs>
      <li>ConveyorBelts.ITab_Port</li>
    </inspectorTabs>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>50</basePowerConsumption>
        <shortCircuitInRain>false</shortCircuitInRain>
      </li>
    </comps>
  </ThingDef>
  <ThingDef ParentName="CB_MachineBase">
    <defName>CB_OutputPort</defName>
    <label>output port</label>
    <description>Takes the stacks a belt delivers into it and puts them on the cell it faces, merging with a stack of the same item there. If that cell can't take the item it either holds it (the belt backs up) or spills it nearby, as set in its Port tab. Draws 50 W.</description>
    <thingClass>ConveyorBelts.Building_OutputPort</thingClass>
    <tickerType>Normal</tickerType>
    <graphicData>
      <texPath>ConveyorBelts/OutputPort</texPath>
    </graphicData>
    <uiIconPath>ConveyorBelts/OutputPort_north</uiIconPath>
    <inspectorTabs>
      <li>ConveyorBelts.ITab_Port</li>
    </inspectorTabs>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>50</basePowerConsumption>
        <shortCircuitInRain>false</shortCircuitInRain>
      </li>
    </comps>
  </ThingDef>
</Defs>
